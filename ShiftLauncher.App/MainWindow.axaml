<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="using:ShiftLauncher.App.ViewModels"
        mc:Ignorable="d"
        d:DesignWidth="1180"
        d:DesignHeight="780"
        x:Class="ShiftLauncher.App.MainWindow"
        x:DataType="viewModels:MainWindowViewModel"
        Title="Link Launcher"
        Icon="avares://ShiftLauncher.App/Assets/app.ico"
        Width="1180"
        Height="780"
        MinWidth="980"
        MinHeight="660"
        Background="#F5F8F0">

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="16,10" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderBrush" Value="#C8D6C4" />
            <Setter Property="Background" Value="#F8FBF6" />
            <Setter Property="Foreground" Value="#17201C" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderBrush" Value="#C8D6C4" />
            <Setter Property="Background" Value="#F8FBF6" />
            <Setter Property="Foreground" Value="#17201C" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*"
          Margin="24"
          RowSpacing="18">

        <Border Grid.Row="0"
                Background="#121A16"
                BorderBrush="#324237"
                BorderThickness="2"
                CornerRadius="0"
                Padding="18,14">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="18">
                <StackPanel Orientation="Horizontal"
                            Spacing="14"
                            VerticalAlignment="Center">
                    <Image Source="avares://ShiftLauncher.App/Assets/logo.png"
                           Width="52"
                           Height="52" />

                    <StackPanel Spacing="2">
                        <TextBlock Text="Link Launcher"
                                   FontSize="34"
                                   Foreground="#FFFFFF" />

                        <TextBlock Text="Minecraft, perfis e mods num só lugar"
                                   Foreground="#CFE1D0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                    <TextBlock Text="Tema"
                               Foreground="#CFE1D0"
                               VerticalAlignment="Center"
                               FontWeight="Bold" />

                    <ComboBox ItemsSource="{Binding ThemeModes}"
                              SelectedItem="{Binding SelectedThemeMode}"
                              Width="130" />

                    <Border Background="#91EB65"
                            BorderBrush="#5BB848"
                            BorderThickness="2"
                            CornerRadius="0"
                            Padding="12,8">
                        <TextBlock Text="BETA"
                                   FontWeight="Bold"
                                   Foreground="#0F1B13" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="310,*"
              ColumnSpacing="18">

            <Border Grid.Column="0"
                    Background="#FFFFFF"
                    BorderBrush="#D8E0D5"
                    BorderThickness="2"
                    CornerRadius="0"
                    Padding="18">
                <StackPanel Spacing="14">
                    <TextBlock Text="Conta"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#17201C" />

                    <Border Background="#EDF3E9"
                            BorderBrush="#C8D6C4"
                            BorderThickness="2"
                            CornerRadius="0"
                            Padding="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding AccountText}"
                                       Foreground="#2F7A45"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="{Binding PlayerName, StringFormat=Jogador: {0}}"
                                       Foreground="#5B675F" />
                        </StackPanel>
                    </Border>

                    <Button Content="Entrar com Microsoft"
                            Command="{Binding LoginMicrosoftCommand}"
                            Background="#91EB65"
                            Foreground="#0F1B13"
                            BorderBrush="#5BB848"
                            HorizontalAlignment="Stretch" />

                    <Button Content="Jogar Online"
                            Command="{Binding PlayOnlineCommand}"
                            Background="#58B957"
                            Foreground="#0F1B13"
                            BorderBrush="#3C8F3B"
                            HorizontalAlignment="Stretch" />

                    <Button Content="Jogar Offline"
                            Command="{Binding PlayOfflineCommand}"
                            Background="#F8FBF6"
                            BorderBrush="#C8D6C4"
                            Foreground="#17201C"
                            HorizontalAlignment="Stretch" />

                    <Separator Margin="0,6" />

                    <TextBlock Text="Instalações"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#17201C" />

                    <ComboBox ItemsSource="{Binding Installations}"
                              SelectedItem="{Binding SelectedInstallation, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" />

                    <Grid ColumnDefinitions="*,*,*"
                          ColumnSpacing="8">
                        <Button Grid.Column="0"
                                Content="+"
                                Command="{Binding NewInstallationCommand}"
                                Background="#F8FBF6"
                                BorderBrush="#C8D6C4"
                                Foreground="#17201C"
                                HorizontalAlignment="Stretch" />

                        <Button Grid.Column="1"
                                Content="⧉"
                                Command="{Binding DuplicateInstallationCommand}"
                                Background="#F8FBF6"
                                BorderBrush="#C8D6C4"
                                Foreground="#17201C"
                                HorizontalAlignment="Stretch" />

                        <Button Grid.Column="2"
                                Content="×"
                                Command="{Binding DeleteInstallationCommand}"
                                Background="#F8FBF6"
                                BorderBrush="#C8D6C4"
                                Foreground="#17201C"
                                HorizontalAlignment="Stretch" />
                    </Grid>

                    <Button Content="Abrir pasta da instalação"
                            Command="{Binding OpenInstallationFolderCommand}"
                            Background="#F8FBF6"
                            BorderBrush="#C8D6C4"
                            Foreground="#17201C"
                            HorizontalAlignment="Stretch" />

                    <Separator Margin="0,6" />

                    <TextBlock Text="Pasta do jogo"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#17201C" />

                    <TextBlock Text="{Binding GameDirectory}"
                               Foreground="#5B675F"
                               TextWrapping="Wrap" />

                    <Button Content="Abrir pasta do jogo"
                            Command="{Binding OpenGameFolderCommand}"
                            Background="#F8FBF6"
                            BorderBrush="#C8D6C4"
                            Foreground="#17201C"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="1"
                  RowDefinitions="Auto,Auto,*"
                  RowSpacing="18">

                <Border Grid.Row="0"
                        Background="#FFFFFF"
                        BorderBrush="#D8E0D5"
                        BorderThickness="2"
                        CornerRadius="0"
                        Padding="18">
                    <!-- BLOCO: editor da instalacao selecionada -->
                    <Grid ColumnDefinitions="*,220"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="18"
                          RowSpacing="10">

                        <StackPanel Grid.Row="0"
                                    Grid.ColumnSpan="2"
                                    Spacing="2">
                            <TextBlock Text="Instalacao atual"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#17201C" />

                            <TextBlock Text="{Binding InstallationSummary}"
                                       Foreground="#5B675F" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Spacing="6">
                            <TextBlock Text="Nome"
                                       FontWeight="Bold"
                                       Foreground="#17201C" />

                            <TextBox Text="{Binding InstallationName, Mode=TwoWay}"
                                     HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <StackPanel Grid.Row="2"
                                    Grid.Column="0"
                                    Spacing="6">
                            <TextBlock Text="Minecraft"
                                       FontWeight="Bold"
                                       Foreground="#17201C" />

                            <!-- Usa FilteredVersions para mudar a lista conforme filtros Vanilla ou loader selecionado. -->
                            <ComboBox ItemsSource="{Binding FilteredVersions}"
                                      SelectedItem="{Binding SelectedVersion}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <StackPanel Grid.Row="2"
                                    Grid.Column="1"
                                    Spacing="6">
                            <TextBlock Text="RAM da instancia"
                                       FontWeight="Bold"
                                       Foreground="#17201C" />

                            <ComboBox ItemsSource="{Binding RamOptions}"
                                      SelectedItem="{Binding MaximumRamMb, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <!-- FILTROS: So aparecem quando o loader e Vanilla -->
                        <StackPanel Grid.Row="3"
                                    Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    Spacing="12"
                                    IsVisible="{Binding IsVanillaSelected}">
                            <CheckBox Content="Releases"
                                      IsChecked="{Binding ShowReleases}" />

                            <CheckBox Content="Snapshots"
                                      IsChecked="{Binding ShowSnapshots}" />

                            <CheckBox Content="Old Beta"
                                      IsChecked="{Binding ShowOldBeta}" />

                            <CheckBox Content="Old Alpha"
                                      IsChecked="{Binding ShowOldAlpha}" />
                        </StackPanel>

                        <!-- CONTROLOS: Loader e versao do loader -->
                        <Grid Grid.Row="4"
                              Grid.ColumnSpan="2"
                              ColumnDefinitions="220,*"
                              ColumnSpacing="18">
                            <StackPanel Grid.Column="0"
                                        Spacing="6">
                                <TextBlock Text="Loader"
                                           FontWeight="Bold"
                                           Foreground="#17201C" />

                                <ComboBox ItemsSource="{Binding LoaderTypes}"
                                          SelectedItem="{Binding SelectedLoaderType}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Spacing="6"
                                        IsVisible="{Binding IsLoaderSelected}">
                                <TextBlock Text="Versão do loader"
                                           FontWeight="Bold"
                                           Foreground="#17201C" />

                                <ComboBox ItemsSource="{Binding LoaderVersions}"
                                          SelectedItem="{Binding LoaderVersion, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Spacing="6"
                                        IsVisible="{Binding IsVanillaSelected}">
                                <TextBlock Text="VersÃ£o do loader"
                                           FontWeight="Bold"
                                           Foreground="#17201C" />

                                <Border Background="#EDF3E9"
                                        BorderBrush="#C8D6C4"
                                        BorderThickness="2"
                                        CornerRadius="0"
                                        Padding="10,8">
                                    <TextBlock Text="Vanilla nÃ£o usa loader"
                                               Foreground="#5B675F" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- SLIDER: RAM -->
                        <Slider Grid.Row="5"
                                Grid.ColumnSpan="2"
                                Minimum="0"
                                Maximum="{Binding MaximumRamIndex}"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Value="{Binding SelectedRamIndexValue, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        IsVisible="{Binding IsProgressVisible}"
                        Background="#18241E"
                        BorderBrush="#2F7A45"
                        BorderThickness="2"
                        CornerRadius="0"
                        Padding="18">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Progresso"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF" />

                        <TextBlock Text="Ficheiros"
                                   Foreground="#CFE1D0" />

                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{Binding FileProgressPercent}" />

                        <TextBlock Text="Download"
                                   Foreground="#CFE1D0" />

                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{Binding ByteProgressPercent}" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2"
                      ColumnDefinitions="*,310"
                      ColumnSpacing="18">
                    <Border Grid.Column="0"
                            Background="#101713"
                            BorderBrush="#2F7A45"
                            BorderThickness="2"
                            CornerRadius="0"
                            Padding="18">
                        <Grid RowDefinitions="Auto,Auto,*"
                              RowSpacing="10">
                            <StackPanel Grid.Row="0"
                                        Spacing="2">
                                <TextBlock Text="Mission Control"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF" />

                                <TextBlock Text="{Binding StatusText}"
                                           Foreground="#CFE1D0"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Separator Grid.Row="1"
                                       Background="#2F7A45" />

                            <ScrollViewer Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding MinecraftConsoleText}"
                                         AcceptsReturn="True"
                                         IsReadOnly="True"
                                         TextWrapping="NoWrap"
                                         FontFamily="Consolas"
                                         Background="#101713"
                                         Foreground="#91EB65"
                                         BorderThickness="0"
                                         MinHeight="220" />
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            Background="#FFFFFF"
                            BorderBrush="#D8E0D5"
                            BorderThickness="2"
                            CornerRadius="0"
                            Padding="18">
                        <Grid RowDefinitions="Auto,Auto,*"
                              RowSpacing="10">
                            <StackPanel Grid.Row="0"
                                        Spacing="2">
                                <TextBlock Text="Erros e eventos"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#17201C" />

                                <TextBlock Text="Seleciona um evento para ver detalhes técnicos."
                                           Foreground="#5B675F"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <ComboBox Grid.Row="1"
                                      ItemsSource="{Binding Logs}"
                                      SelectedItem="{Binding SelectedLogEntry}"
                                      HorizontalAlignment="Stretch" />

                            <ScrollViewer Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding SelectedLogDetails}"
                                         AcceptsReturn="True"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         MinHeight="220" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
