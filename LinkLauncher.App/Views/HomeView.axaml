<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="using:LinkLauncher.App.ViewModels"
             xmlns:models="using:LinkLauncher.Core.Models"
             mc:Ignorable="d"
             x:Class="LinkLauncher.App.Views.HomeView"
             x:DataType="viewModels:HomeViewModel">

    <Grid RowDefinitions="Auto,*"
          RowSpacing="18">

        <Border Grid.Row="0"
                Background="#C59A71"
                BorderBrush="#4A2D1B"
                BorderThickness="2"
                CornerRadius="6"
                Padding="22">
            <Grid ColumnDefinitions="*,260"
                  ColumnSpacing="18">
                <StackPanel Spacing="6">
                    <TextBlock Text="Home"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#2A1A10" />

                    <TextBlock Text="O teu painel principal do launcher: instancias recentes, noticias e changelog."
                               TextWrapping="Wrap"
                               Foreground="#5B3922" />

                    <Border Background="#E7C9A2"
                            BorderBrush="#6F4A2D"
                            BorderThickness="2"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,8,0,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Estado atual"
                                       FontWeight="Bold"
                                       Foreground="#2A1A10" />

                            <TextBlock Text="{Binding App.StatusText}"
                                       TextWrapping="Wrap"
                                       Foreground="#6A4B37" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#2F2218"
                        BorderBrush="#6FC546"
                        BorderThickness="2"
                        CornerRadius="6"
                        Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Conta"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#F7FFEF" />

                        <TextBlock Text="{Binding App.AccountText}"
                                   TextWrapping="Wrap"
                                   Foreground="#DCECCB" />

                        <TextBlock Text="{Binding App.PlayerLabelText}"
                                   TextWrapping="Wrap"
                                   Foreground="#8ED85E" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="1.2*,1.2*,0.9*"
              ColumnSpacing="18">

            <Border Grid.Column="0"
                    Background="#D1A57D"
                    BorderBrush="#4A2D1B"
                    BorderThickness="2"
                    CornerRadius="6"
                    Padding="18">
                <Grid RowDefinitions="Auto,Auto,*"
                      RowSpacing="12">
                    <StackPanel Grid.Row="0"
                                Spacing="2">
                        <TextBlock Text="Instancias recentes"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#2A1A10" />

                        <TextBlock Text="{Binding RecentInstallationsSubtitleText}"
                                   TextWrapping="Wrap"
                                   Foreground="#6A4B37" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="#E7C9A2"
                            BorderBrush="#6F4A2D"
                            BorderThickness="2"
                            CornerRadius="4"
                            Padding="10">
                        <TextBlock Text="{Binding App.InstallationSummary}"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   Foreground="#2A1A10" />
                    </Border>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RecentInstallations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:LauncherProfile">
                                    <Border Background="#E7C9A2"
                                            BorderBrush="#6F4A2D"
                                            BorderThickness="2"
                                            CornerRadius="4"
                                            Padding="12"
                                            Margin="0,0,0,10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="#2A1A10" />

                                            <TextBlock Text="{Binding MinecraftVersion, StringFormat='Versao: {0}'}"
                                                       Foreground="#6A4B37" />

                                            <TextBlock Text="{Binding PlayerName, StringFormat='Jogador: {0}'}"
                                                       Foreground="#5B3922" />

                                            <TextBlock Text="{Binding LastPlayedAtUtc, StringFormat='Ultima vez: {0:dd/MM/yyyy HH:mm}'}"
                                                       Foreground="#6A4B37" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="#D1A57D"
                    BorderBrush="#4A2D1B"
                    BorderThickness="2"
                    CornerRadius="6"
                    Padding="18">
                <Grid RowDefinitions="Auto,*"
                      RowSpacing="12">
                    <StackPanel Grid.Row="0"
                                Spacing="2">
                        <TextBlock Text="Noticias do jogo"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#2A1A10" />

                        <TextBlock Text="{Binding NewsSubtitleText}"
                                   TextWrapping="Wrap"
                                   Foreground="#6A4B37" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding NewsItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:HomeNewsItem">
                                    <Border Background="#E7C9A2"
                                            BorderBrush="#6F4A2D"
                                            BorderThickness="2"
                                            CornerRadius="4"
                                            Padding="14"
                                            Margin="0,0,0,12">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{Binding Category}"
                                                       Foreground="#6A4B37" />

                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="#2A1A10" />

                                            <TextBlock Text="{Binding Summary}"
                                                       TextWrapping="Wrap"
                                                       Foreground="#6A4B37" />

                                            <TextBlock Text="{Binding Footer}"
                                                       Foreground="#5B3922" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="#C59A71"
                    BorderBrush="#4A2D1B"
                    BorderThickness="2"
                    CornerRadius="6"
                    Padding="18">
                <Grid RowDefinitions="Auto,*"
                      RowSpacing="12">
                    <StackPanel Grid.Row="0"
                                Spacing="2">
                        <TextBlock Text="Changelog"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#2A1A10" />

                        <TextBlock Text="{Binding ChangelogSubtitleText}"
                                   TextWrapping="Wrap"
                                   Foreground="#6A4B37" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ChangelogItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:LauncherChangelogItem">
                                    <Border Background="#E7C9A2"
                                            BorderBrush="#6F4A2D"
                                            BorderThickness="2"
                                            CornerRadius="4"
                                            Padding="12"
                                            Margin="0,0,0,10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding Version}"
                                                       FontWeight="Bold"
                                                       Foreground="#2A1A10" />

                                            <TextBlock Text="{Binding Summary}"
                                                       TextWrapping="Wrap"
                                                       Foreground="#6A4B37" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>
