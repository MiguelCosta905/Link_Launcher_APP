<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="using:LinkLauncher.App.ViewModels"
             xmlns:converters="using:LinkLauncher.App.Converters"

             mc:Ignorable="d"
             x:Class="LinkLauncher.App.Views.LibraryView"
             x:DataType="viewModels:LibraryViewModel">

    <UserControl.Styles>
        <Style Selector="ListBox.instance-list">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="ListBox.instance-list ListBoxItem">
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style Selector="ListBox.instance-list ListBoxItem:pointerover">
            <Setter Property="Background" Value="#BE8D64" />
        </Style>

        <Style Selector="ListBox.instance-list ListBoxItem:selected">
            <Setter Property="Background" Value="#7A4D2E" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="ListBox.instance-list ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBox.instance-list ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#7A4D2E" />
        </Style>

        <Style Selector="ListBox.instance-list ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#BE8D64" />
        </Style>

        <Style Selector="ListBox.instance-list ListBoxItem /template/ Rectangle#FocusVisual">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*"
          RowSpacing="18">

        <Border Grid.Row="0"
                Background="#C59A71"
                BorderBrush="#4A2D1B"
                BorderThickness="2"
                CornerRadius="6"
                Padding="22">
            <Grid ColumnDefinitions="*,260"
                  ColumnSpacing="18">
                <StackPanel Spacing="6">
                    <TextBlock Text="Biblioteca"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#2A1A10" />

                    <TextBlock Text="Escolhe uma instancia e abre os detalhes dela, com um layout mais limpo e focado."
                               TextWrapping="Wrap"
                               Foreground="#5B3922" />

                    <Border Background="#E7C9A2"
                            BorderBrush="#6F4A2D"
                            BorderThickness="2"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,8,0,0">
                        <TextBlock Text="{Binding InstallationSummary}"
                                   TextWrapping="Wrap"
                                   FontWeight="Bold"
                                   Foreground="#2A1A10" />
                    </Border>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#2F2218"
                        BorderBrush="#6FC546"
                        BorderThickness="2"
                        CornerRadius="6"
                        Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Conta"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#F7FFEF" />

                        <TextBlock Text="{Binding AccountText}"
                                   TextWrapping="Wrap"
                                   Foreground="#DCECCB" />

                        <TextBlock Text="{Binding PlayerLabelText}"
                                   TextWrapping="Wrap"
                                   Foreground="#8ED85E" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="1.35*,0.95*"
              ColumnSpacing="18">

            <Border Grid.Column="0"
                    Background="#D1A57D"
                    BorderBrush="#4A2D1B"
                    BorderThickness="2"
                    CornerRadius="6"
                    Padding="18">
                <Grid RowDefinitions="Auto,*"
                      RowSpacing="14">
                    <StackPanel Grid.Row="0"
                                Spacing="2">
                        <TextBlock Text="Instancias"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#2A1A10" />

                        <TextBlock Text="Visual de biblioteca em cards. Mais perto do estilo CurseForge."
                                   TextWrapping="Wrap"
                                   Foreground="#6A4B37" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <ListBox Classes="instance-list"
                                 ItemsSource="{Binding Installations}"
                                 SelectedItem="{Binding SelectedInstallation, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#E7C9A2"
                                            BorderBrush="#6F4A2D"
                                            BorderThickness="2"
                                            CornerRadius="6"
                                            Padding="12"
                                            Margin="0">
                                        <Grid ColumnDefinitions="72,*"
                                              ColumnSpacing="12">
                                            <Border Width="72"
                                                        Height="72"
                                                        Background="#8B6144"
                                                        BorderBrush="#4A2D1B"
                                                        BorderThickness="2"
                                                        CornerRadius="4"
                                                        ClipToBounds="True"
                                                        Padding="4">
                                                <Grid>
                                                        <Image Source="avares://LinkLauncher.App/Assets/logo.png"
                                                        Stretch="Uniform" />

                                                        <Image Source="{Binding CoverImagePath, Converter={x:Static converters:ImagePathToBitmapConverter.Instance}}"
                                                        Stretch="Uniform" />
                                                </Grid>
                                                </Border>




                                            <StackPanel Grid.Column="1"
                                                        Spacing="4"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="17"
                                                           FontWeight="Bold"
                                                           Foreground="#2A1A10" />

                                                <TextBlock Text="{Binding MinecraftVersion}"
                                                           Foreground="#6A4B37" />

                                                <TextBlock Text="{Binding PlayerName}"
                                                           Foreground="#5B3922" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="#C59A71"
                    BorderBrush="#4A2D1B"
                    BorderThickness="2"
                    CornerRadius="6"
                    Padding="18">
                <Grid RowDefinitions="Auto,Auto,Auto,*"
                      RowSpacing="14">
                    <Grid Grid.Row="0"
                          ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                        <StackPanel Grid.Column="0"
                                    Spacing="2">
                            <TextBlock Text="Detalhes da instancia"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#2A1A10" />

                            <TextBlock Text="Os detalhes aparecem para a instancia selecionada."
                                       TextWrapping="Wrap"
                                       Foreground="#6A4B37" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Background="#E2C39B"
                                BorderBrush="#6F4A2D"
                                Foreground="#2A1A10"
                                VerticalAlignment="Top"
                                Content="{Binding DetailsEditButtonText}"
                                Command="{Binding ToggleDetailsEditModeCommand}" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid IsVisible="{Binding IsDetailsSummaryVisible}"
                              ColumnDefinitions="*,*"
                              ColumnSpacing="12"
                              RowDefinitions="Auto,Auto">
                            <Border Grid.Row="0"
                                    Grid.Column="0"
                                    Background="#E7C9A2"
                                    BorderBrush="#6F4A2D"
                                    BorderThickness="2"
                                    CornerRadius="4"
                                    Padding="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Nome"
                                               FontWeight="Bold"
                                               Foreground="#2A1A10" />
                                    <TextBlock Text="{Binding InstallationName}"
                                               Foreground="#6A4B37" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0"
                                    Grid.Column="1"
                                    Background="#E7C9A2"
                                    BorderBrush="#6F4A2D"
                                    BorderThickness="2"
                                    CornerRadius="4"
                                    Padding="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Versao"
                                               FontWeight="Bold"
                                               Foreground="#2A1A10" />
                                    <TextBlock Text="{Binding MinecraftVersion}"
                                               Foreground="#6A4B37" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1"
                                    Grid.Column="0"
                                    Background="#E7C9A2"
                                    BorderBrush="#6F4A2D"
                                    BorderThickness="2"
                                    CornerRadius="4"
                                    Padding="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="RAM"
                                               FontWeight="Bold"
                                               Foreground="#2A1A10" />
                                    <TextBlock Text="{Binding SelectedRamLabel}"
                                               Foreground="#6A4B37" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1"
                                    Grid.Column="1"
                                    Background="#E7C9A2"
                                    BorderBrush="#6F4A2D"
                                    BorderThickness="2"
                                    CornerRadius="4"
                                    Padding="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Loader"
                                               FontWeight="Bold"
                                               Foreground="#2A1A10" />
                                    <TextBlock Text="{Binding ModLoaderSummary}"
                                               Foreground="#6A4B37" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel IsVisible="{Binding IsDetailsEditMode}"
                                    Spacing="12">
                            <Border Background="#E7C9A2"
                                    BorderBrush="#6F4A2D"
                                    BorderThickness="2"
                                    CornerRadius="4"
                                    Padding="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Nome da instancia"
                                               FontWeight="Bold"
                                               Foreground="#2A1A10" />
                                    <TextBox Text="{Binding InstallationName, Mode=TwoWay}"
                                             Watermark="Nome da instancia" />
                                </StackPanel>
                            </Border>

                            <Border Background="#E7C9A2"
                                    BorderBrush="#6F4A2D"
                                    BorderThickness="2"
                                    CornerRadius="4"
                                    Padding="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="RAM alocada"
                                               FontWeight="Bold"
                                               Foreground="#2A1A10" />

                                    <TextBlock Text="{Binding SelectedRamLabel}"
                                               FontWeight="SemiBold"
                                               Foreground="#6A4B37" />

                                    <Grid ColumnDefinitions="76,*"
                                          ColumnSpacing="6">
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding RamOptions}"
                                                  SelectedItem="{Binding SelectedRamOption, Mode=TwoWay}" />

                                        <Slider Grid.Column="1"
                                                Minimum="0"
                                                Maximum="{Binding MaximumRamIndex}"
                                                Value="{Binding SelectedRamIndexValue, Mode=TwoWay}"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border IsVisible="{Binding CanEditLoaderVersion}"
                                    Background="#E7C9A2"
                                    BorderBrush="#6F4A2D"
                                    BorderThickness="2"
                                    CornerRadius="4"
                                    Padding="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Versao do loader"
                                               FontWeight="Bold"
                                               Foreground="#2A1A10" />
                                    <ComboBox ItemsSource="{Binding LoaderVersions}"
                                              SelectedItem="{Binding LoaderVersion, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>

                            <Border IsVisible="{Binding IsVanillaSelected}"
                                    Background="#E7C9A2"
                                    BorderBrush="#6F4A2D"
                                    BorderThickness="2"
                                    CornerRadius="4"
                                    Padding="12">
                                <TextBlock Text="Esta instancia usa Vanilla, por isso nao ha versao de loader para editar."
                                           TextWrapping="Wrap"
                                           Foreground="#6A4B37" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2"
                          ColumnDefinitions="*,*"
                          ColumnSpacing="8">
                        <Button Grid.Column="0"
                                Background="#E2C39B"
                                BorderBrush="#6F4A2D"
                                Foreground="#2A1A10"
                                Content="{Binding OpenInstallationFolderButtonText}"
                                Command="{Binding OpenInstallationFolderCommand}" />

                        <Button Grid.Column="1"
                                Background="#E2C39B"
                                BorderBrush="#6F4A2D"
                                Foreground="#2A1A10"
                                Content="{Binding OpenGameFolderButtonText}"
                                Command="{Binding OpenGameFolderCommand}" />
                    </Grid>

                    <StackPanel Grid.Row="3"
                                Spacing="10"
                                VerticalAlignment="Top">
                        <Button Background="#5FAE46"
                                BorderBrush="#3F742F"
                                Foreground="#F4FFE9"
                                Content="{Binding PlayOnlineButtonText}"
                                Command="{Binding PlayOnlineCommand}" />

                        <Button Background="#8ED85E"
                                BorderBrush="#4C7F2A"
                                Foreground="#11200D"
                                Content="{Binding PlayOfflineButtonText}"
                                Command="{Binding PlayOfflineCommand}" />

                        <Button Background="#E2C39B"
                                BorderBrush="#6F4A2D"
                                Foreground="#2A1A10"
                                Content="{Binding LoginMicrosoftButtonText}"
                                Command="{Binding LoginMicrosoftCommand}" />

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="8"
                              Margin="0,4,0,0">
                            <Button Grid.Column="0"
                                    Background="#E2C39B"
                                    BorderBrush="#6F4A2D"
                                    Foreground="#2A1A10"
                                    Content="{Binding CopyInstallationButtonText}"
                                    Command="{Binding DuplicateInstallationCommand}" />

                            <Button Grid.Column="1"
                                    Background="#D88E7C"
                                    BorderBrush="#8F473C"
                                    Foreground="#2A1A10"
                                    Content="{Binding DeleteInstallationButtonText}"
                                    Command="{Binding DeleteInstallationCommand}" />
                        </Grid>

                        <Border Background="#E7C9A2"
                                BorderBrush="#6F4A2D"
                                BorderThickness="2"
                                CornerRadius="4"
                                Padding="12"
                                Margin="0,8,0,0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Estado atual"
                                           FontWeight="Bold"
                                           Foreground="#2A1A10" />
                                <TextBlock Text="{Binding StatusText}"
                                           TextWrapping="Wrap"
                                           Foreground="#6A4B37" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
