<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="using:LinkLauncher.App.ViewModels"
        xmlns:views="using:LinkLauncher.App.Views"
        mc:Ignorable="d"
        x:Class="LinkLauncher.App.MainWindow"
        x:Name="RootWindow"
        x:DataType="viewModels:MainWindowViewModel"

        Title="Link Launcher"
        Icon="avares://LinkLauncher.App/Assets/app.ico"
        Width="1180"
        Height="780"
        MinWidth="980"
        MinHeight="660"
        Background="#5C4030">

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style Selector="Button.nav">
            <Setter Property="Background" Value="#C59A71" />
            <Setter Property="Foreground" Value="#2A1A10" />
            <Setter Property="BorderBrush" Value="#6F4A2D" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderBrush" Value="#4A2D1B" />
            <Setter Property="Background" Value="#E2C39B" />
            <Setter Property="Foreground" Value="#2A1A10" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderBrush" Value="#4A2D1B" />
            <Setter Property="Background" Value="#E2C39B" />
            <Setter Property="Foreground" Value="#2A1A10" />
        </Style>
    </Window.Styles>

    <Border Margin="20"
            Background="#6B4A34"
            BorderBrush="#3D2417"
            BorderThickness="3"
            CornerRadius="8">
        <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0"
                    BorderBrush="#3B6927"
                    BorderThickness="0,0,0,3"
                    CornerRadius="6,6,0,0">
                <Grid RowDefinitions="Auto,14">
                    <Border Grid.Row="0"
                            Padding="18,16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#91EB65" Offset="0" />
                                <GradientStop Color="#5DA13F" Offset="0.55" />
                                <GradientStop Color="#3F742F" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>

                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="18">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="14"
                                        VerticalAlignment="Center">
                                <Image Source="avares://LinkLauncher.App/Assets/logo.png"
                                       Width="52"
                                       Height="52" />

                                <StackPanel Spacing="2">
                                    <TextBlock Text="Link Launcher"
                                               FontSize="34"
                                               FontWeight="Bold"
                                               Foreground="#F7FFEF" />

                                    <TextBlock Text="{Binding TaglineText}"
                                               Foreground="#E4F5D6" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding LanguageLabelText}"
                                           Foreground="#E4F5D6"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold" />

                                <ComboBox ItemsSource="{Binding LanguageOptions}"
                                          SelectedItem="{Binding SelectedLanguageOption}"
                                          Width="170" />

                                <TextBlock Text="{Binding ThemeLabelText}"
                                           Foreground="#E4F5D6"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold" />

                                <ComboBox ItemsSource="{Binding ThemeOptions}"
                                          SelectedItem="{Binding SelectedThemeOption}"
                                          Width="130" />

                                <Border Background="#E4C35B"
                                        BorderBrush="#8C6A22"
                                        BorderThickness="2"
                                        CornerRadius="4"
                                        Padding="12,8">
                                    <TextBlock Text="BETA"
                                               FontWeight="Bold"
                                               Foreground="#3D2A06" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="3*,2*,2*,3*,2*,1*,2*,3*">
                        <Border Grid.Column="0" Background="#4A2D1B" />
                        <Border Grid.Column="1" Background="#6A4128" />
                        <Border Grid.Column="2" Background="#4E301D" />
                        <Border Grid.Column="3" Background="#7A4D2E" />
                        <Border Grid.Column="4" Background="#5B3922" />
                        <Border Grid.Column="5" Background="#3C2416" />
                        <Border Grid.Column="6" Background="#6D452C" />
                        <Border Grid.Column="7" Background="#4A2D1B" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Padding="22">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#7A563B" Offset="0" />
                        <GradientStop Color="#68472F" Offset="0.45" />
                        <GradientStop Color="#5C4030" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid ColumnDefinitions="220,*"
                      ColumnSpacing="18">
                    <Border Grid.Column="0"
                            Background="#8B6144"
                            BorderBrush="#4A2D1B"
                            BorderThickness="2"
                            CornerRadius="6"
                            Padding="14">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Navegacao"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#FFF4E8" />

                            <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                  RowSpacing="8">
                                <Grid Grid.Row="0"
                                      ColumnDefinitions="4,*">
                                    <Border Background="#91EB65"
                                            IsVisible="{Binding IsHomeSelected}" />
                                    <Button Grid.Column="1"
                                            Classes="nav"
                                            Content="Home"
                                            Command="{Binding ShowHomeCommand}" />
                                </Grid>

                                <Grid Grid.Row="1"
                                      ColumnDefinitions="4,*">
                                    <Border Background="#91EB65"
                                            IsVisible="{Binding IsSkinsSelected}" />
                                    <Button Grid.Column="1"
                                            Classes="nav"
                                            Content="Skins"
                                            Command="{Binding ShowSkinsCommand}" />
                                </Grid>

                                <Grid Grid.Row="2"
                                      ColumnDefinitions="4,*">
                                    <Border Background="#91EB65"
                                            IsVisible="{Binding IsLibrarySelected}" />
                                    <Button Grid.Column="1"
                                            Classes="nav"
                                            Content="Biblioteca"
                                            Command="{Binding ShowLibraryCommand}" />
                                </Grid>

                                <Grid Grid.Row="3"
                                      ColumnDefinitions="4,*">
                                    <Border Background="#91EB65"
                                            IsVisible="{Binding IsCreateSelected}" />
                                    <Button Grid.Column="1"
                                            Classes="nav"
                                            Content="Criar"
                                            Command="{Binding ShowCreateCommand}" />
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Column="1">
                <views:HomeView DataContext="{Binding HomePage}"
                    IsVisible="{Binding DataContext.IsHomeSelected, ElementName=RootWindow}" />
                <views:SkinsView DataContext="{Binding SkinsPage}"
                    IsVisible="{Binding DataContext.IsSkinsSelected, ElementName=RootWindow}" />
                <views:LibraryView DataContext="{Binding LibraryPage}"
                    IsVisible="{Binding DataContext.IsLibrarySelected, ElementName=RootWindow}" />
                <views:CreateView DataContext="{Binding CreatePage}"
                    IsVisible="{Binding DataContext.IsCreateSelected, ElementName=RootWindow}" />

                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
